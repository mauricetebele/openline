{
  "manifest_version": 3,
  "name": "Openline — Seller Note Fetcher",
  "version": "1.0.0",
  "description": "On-demand: fetch a Seller Central order's Seller Note using your logged-in session.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://sellercentral.amazon.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Seller Note Fetcher"
  },
  "background": {
    "service_worker": "background.js"
  }
}
